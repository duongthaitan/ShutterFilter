{
  "$schema": "https://raw.githubusercontent.com/electron-userland/electron-builder/master/packages/app-builder-lib/scheme.json",
  "appId": "com.tandev.shutterfilter",
  "productName": "ShutterFilter by Tandev.foto",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*",
    "assets/**/*",
    "package.json"
  ],
  "win": {
    "icon": "assets/icon.ico",
    "target": [
      {
        "target": "portable",
        "arch": [
          "x64"
        ]
      },
      {
        "target": "dir",
        "arch": [
          "x64"
        ]
      }
    ]
  },
  "portable": {
    "artifactName": "ShutterFilter_by_Tandev.foto.exe",
    "splashImage": null
  }
}
